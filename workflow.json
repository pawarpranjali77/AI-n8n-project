{
  "name": "Hourly Weather Pipeline",
  "nodes": [
    {
      "id": "n1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "n2",
      "name": "Fetch Weather (Open-Meteo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.open-meteo.com/v1/forecast?latitude=18.5204&longitude=73.8567&current=temperature_2m,relative_humidity_2m,wind_speed_10m,precipitation&timezone=Asia%2FKolkata",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "n3",
      "name": "Clean & Flag (Python)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "language": "python",
        "pythonCode": "out = []\nfor item in _input.all():\n    c = item.json[\"current\"]\n    t = c[\"temperature_2m\"]\n    out.append({\"json\": {\n        \"timestamp\": c[\"time\"],\n        \"city\": \"Pune\",\n        \"temperature_c\": t,\n        \"humidity_pct\": c[\"relative_humidity_2m\"],\n        \"wind_kmh\": c[\"wind_speed_10m\"],\n        \"precip_mm\": c[\"precipitation\"],\n        \"heat_alert\": t >= 35,\n    }})\nreturn out"
      }
    },
    {
      "id": "n4",
      "name": "Append to Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        680,
        -100
      ],
      "parameters": {
        "resource": "sheet",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": null
        },
        "options": {}
      },
      "disabled": true
    },
    {
      "id": "n5",
      "name": "Temp >= 35C?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.temperature_c }}",
              "rightValue": 35,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n6",
      "name": "Build Alert Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        40
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "alert",
              "type": "string",
              "value": "=HEAT ALERT {{ $json.city }}: {{ $json.temperature_c }}C at {{ $json.timestamp }}"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Fetch Weather (Open-Meteo)": {
      "main": [
        [
          {
            "node": "Clean & Flag (Python)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Clean & Flag (Python)": {
      "main": [
        [
          {
            "node": "Append to Google Sheet",
            "type": "main",
            "index": 0
          },
          {
            "node": "Temp >= 35C?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Temp >= 35C?": {
      "main": [
        [
          {
            "node": "Build Alert Message",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Fetch Weather (Open-Meteo)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
